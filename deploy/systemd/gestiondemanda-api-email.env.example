# Configuracion SMTP para gestiondemanda-api.service
# Copiar a /etc/gestiondemanda-api/email.env y completar valores reales.

EMAIL_ENABLED=true
EMAIL_FROM=no-reply@dssm.cl
EMAIL_FROM_NAME="Gestion Demanda DSSM"

# SMTP institucional
SMTP_HOST=smtp.institucional.cl
SMTP_PORT=587
SMTP_USERNAME=usuario_smtp
SMTP_PASSWORD="clave_smtp"

# 587 normalmente usa STARTTLS=true y SSL=false
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=false
SMTP_SSL_ENABLE=false
SMTP_DEBUG=false

SMTP_CONNECTION_TIMEOUT=10000
SMTP_TIMEOUT=10000
SMTP_WRITE_TIMEOUT=10000
